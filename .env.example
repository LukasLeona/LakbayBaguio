# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key used by /api/restaurant-inquiries. Never expose this value.
SUPABASE_SERVICE_ROLE_KEY=

# Free Cloudflare Turnstile bot protection. Add both values together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional MapLibre style URL. The default is suitable for development previews.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Server-only Google Places API (New) key for Baguio accommodation autocomplete.
# Keep this out of NEXT_PUBLIC_* and restrict the key to Places API (New).
GOOGLE_PLACES_API_KEY=

# Optional server-side EmailJS overrides used by /api/contact.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Server-only authorization required when EmailJS strict API mode is enabled.
EMAILJS_PRIVATE_KEY=

# Public EmailJS browser settings for the dedicated Baguio Buddy inquiry template.
# These identifiers are browser-safe; never put an EmailJS private key in NEXT_PUBLIC_*.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_INQUIRY_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
