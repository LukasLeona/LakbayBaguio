# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key used by /api/restaurant-inquiries. Never expose this value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional MapLibre style URL. The default is suitable for development previews.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Keep false while testing elsewhere. Set true to restrict Nearby to the Baguio area.
NEXT_PUBLIC_ENFORCE_BAGUIO_GEOFENCE=false

# Optional EmailJS overrides. Defaults mirror the working lukasleona.com contact form.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
